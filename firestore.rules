rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read: if true;
      allow write: if request.auth != null && (request.auth.token.email == "elussila@gmail.com" || request.auth.token.email == "jgmansur2@gmail.com");
    }
  }
}
