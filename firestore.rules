rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email != null
        && (
          request.auth.token.email == "elussila@gmail.com"
          || request.auth.token.email == "jgmansur2@gmail.com"
          || request.auth.token.email.matches(".*jaystudio.*")
        );
    }

    match /{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
