rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email != null
        && (
          request.auth.token.email == "elussila@gmail.com"
          || request.auth.token.email == "jgmansur2@gmail.com"
          || request.auth.token.email.matches(".*jaystudio.*")
        );
    }

    match /{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
